generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
}

enum LoadStatus {
  BOOKED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ExpenseCategory {
  FUEL
  OIL
  TIRES
  REPAIRS
  TOLLS
  SCALES
  PERMITS
  INSURANCE
  FOOD
  OTHER
}

enum DocumentAlertStatus {
  CURRENT
  EXPIRING_SOON
  EXPIRED
  MISSING
}

model Load {
  id           String     @id @default(cuid())
  loadNumber   String?
  broker       String?
  origin       String
  destination  String
  miles        Float?
  rate         Float?
  ratePerMile  Float?
  status       LoadStatus @default(BOOKED)
  pickupDate   DateTime?
  deliveryDate DateTime?
  commodity    String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  expenses     Expense[]
}

model Expense {
  id          String          @id @default(cuid())
  loadId      String?
  load        Load?           @relation(fields: [loadId], references: [id], onDelete: SetNull)
  category    ExpenseCategory
  amount      Float
  expenseDate DateTime
  vendor      String?
  location    String?
  notes       String?
  receiptPath String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model FuelLog {
  id             String   @id @default(cuid())
  fuelDate       DateTime
  gallons        Float
  pricePerGallon Float
  totalCost      Float
  location       String?
  odometer       Float?
  state          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DocumentAlert {
  id          String              @id @default(cuid())
  title       String
  expiresDate DateTime?
  status      DocumentAlertStatus @default(CURRENT)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}
