{
  "name": "owner-operator-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "pilot:build": "node scripts/build.mjs",
    "pilot:prisma:generate": "prisma generate --schema prisma/pilot/schema.prisma",
    "pilot:migrate:deploy": "prisma migrate deploy --schema prisma/pilot/schema.prisma",
    "pilot:seed": "node --no-warnings --experimental-strip-types scripts/seed-pilot.mts",
    "pilot:local:prepare": "node scripts/prepare-local-pilot.mjs",
    "start": "next start",
    "postinstall": "npm run prisma:generate && npm run pilot:prisma:generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "retention:cleanup": "node --no-warnings --experimental-strip-types src/lib/retention-cli.ts",
    "seed": "node prisma/seed.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^1.21.0",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
